{
  "uid": "fleetmind-telemetry",
  "title": "FleetMind · Telemetry processing",
  "description": "Missing series represent unavailable observations. Each instance is a separate process target.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "fleetmind"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Deliveries by stage",
      "datasource": {
        "type": "prometheus",
        "uid": "fleetmind-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fleetmind-prometheus"
          },
          "expr": "sum by (stage) (rate(fleetmind_telemetry_events_total[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "Unavailable",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Validation rejections",
      "datasource": {
        "type": "prometheus",
        "uid": "fleetmind-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fleetmind-prometheus"
          },
          "expr": "sum by (category) (increase(fleetmind_telemetry_rejected_total[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Committed lag",
      "datasource": {
        "type": "prometheus",
        "uid": "fleetmind-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fleetmind-prometheus"
          },
          "expr": "fleetmind_worker_committed_lag{job=\"fleetmind-worker\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Delivery phase p95",
      "datasource": {
        "type": "prometheus",
        "uid": "fleetmind-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fleetmind-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le,operation) (rate(fleetmind_operation_duration_seconds_bucket{job=\"fleetmind-worker\",operation=~\"telemetry_.*|offset_acknowledgement|model_inference|feature_preparation\"}[5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unavailable",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
