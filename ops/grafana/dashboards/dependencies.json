{
  "uid": "fleetmind-dependencies",
  "title": "FleetMind · Database and broker health",
  "description": "Missing series represent unavailable observations. Each instance is a separate process target.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "fleetmind"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "PostgreSQL availability",
      "datasource": {
        "type": "prometheus",
        "uid": "fleetmind-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fleetmind-prometheus"
          },
          "expr": "fleetmind_dependency_available{dependency=\"postgresql\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Redpanda reachability",
      "datasource": {
        "type": "prometheus",
        "uid": "fleetmind-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fleetmind-prometheus"
          },
          "expr": "fleetmind_dependency_available{dependency=\"redpanda\",job=\"fleetmind-worker\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Telemetry transaction p95",
      "datasource": {
        "type": "prometheus",
        "uid": "fleetmind-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fleetmind-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le,instance) (rate(fleetmind_operation_duration_seconds_bucket{operation=\"telemetry_transaction\"}[5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unavailable",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
