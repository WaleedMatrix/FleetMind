{
  "uid": "fleetmind-resources",
  "title": "FleetMind · Application resource utilization",
  "description": "Missing series represent unavailable observations. Each instance is a separate process target.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "fleetmind"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Resident memory by process",
      "datasource": {
        "type": "prometheus",
        "uid": "fleetmind-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fleetmind-prometheus"
          },
          "expr": "fleetmind_process_resident_memory_bytes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Unavailable",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU core equivalents",
      "datasource": {
        "type": "prometheus",
        "uid": "fleetmind-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fleetmind-prometheus"
          },
          "expr": "rate(fleetmind_process_cpu_seconds_total[5m])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Scrape target health",
      "datasource": {
        "type": "prometheus",
        "uid": "fleetmind-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fleetmind-prometheus"
          },
          "expr": "up{job=~\"fleetmind-.*\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
