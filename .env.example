APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO

POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql+psycopg://fleetmind:replace-me@127.0.0.1:5433/fleetmind

# Use 1 only with loopback HTTP. Otherwise configure exact HTTPS origins and set 0.
FLEETMIND_AUTH_INSECURE_LOCAL_HTTP=1
FLEETMIND_AUTH_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FLEETMIND_AUTH_SESSION_MINUTES=480

# Optional installations are documented in docs/operations.md and docs/mlops.md.
