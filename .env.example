APP_ENV=development
APP_VERSION=0.1.0

LOG_LEVEL=INFO

POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql+psycopg://fleetmind:replace-me@localhost:5433/fleetmind

MODEL_PATH=artifacts/fleetmind_model.joblib

MODEL_VERSION=fleetmind-0.1.0

# Explicit local HTTP development. Set 0 and configure exact HTTPS origins in production.
FLEETMIND_AUTH_INSECURE_LOCAL_HTTP=1
FLEETMIND_AUTH_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FLEETMIND_AUTH_SESSION_MINUTES=480
